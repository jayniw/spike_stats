# SpikeStats MVP — variables de entorno
# Copia este archivo a .env.local y completa los valores:
#   pwsh: Copy-Item .env.local.example .env.local
#
# Proyecto Supabase HOSTEADO (cloud, free tier) — NO se usa Docker ni stack local.
# Valores en el dashboard: Project Settings → API (Data API + API Keys):
#   https://supabase.com/dashboard/project/<tu-project-ref>/settings/api

# URL del proyecto Supabase (formato: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima pública ("anon public" / "publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SOLO para scripts de servidor (seed, tests RLS).
# BYPASA TODAS LAS POLÍTICAS RLS: nunca la expongas al navegador ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# IMPORTANTE: las variables con prefijo NEXT_PUBLIC_ son valores PÚBLICOS que
# se incluyen en el bundle del cliente de forma segura (la seguridad la aplican
# RLS + Auth en el servidor, nunca el secretismo de estas claves).
#
# NUNCA coloques aquí la service_role con ese prefijo: cualquier valor
# NEXT_PUBLIC_ termina expuesto en el navegador.
